# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram webhook URL (your bot's public URL where Telegram will send updates)
# For Railway: https://your-railway-domain.up.railway.app/webhook
BOT_WEBHOOK_URL=https://your-domain.com/webhook

# How often to poll for status changes (seconds). 3600 = 1 hour, 7200 = 2 hours
POLL_INTERVAL=3600

# State file path (default: /data/state.json for Docker)
# STATE_FILE=/data/state.json

# Rate limiting (public bot protection)
# Max tracking codes per user (prevent spam)
MAX_CODES_PER_USER=10
# Minimum seconds between checks of the same code (protect CE Express API)
MIN_CHECK_INTERVAL=300

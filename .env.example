# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Webhook kill switch — set to "true" only when you have a public HTTPS domain
# Default: false (webhook disabled, bot won't receive messages)
WEBHOOK_ENABLED=false

# Telegram webhook URL (only used when WEBHOOK_ENABLED=true)
# For Railway: https://your-railway-domain.up.railway.app/webhook
BOT_WEBHOOK_URL=

# How often to poll for status changes (seconds). 3600 = 1 hour, 7200 = 2 hours
POLL_INTERVAL=3600

# State file path (default: /data/state.json for Docker)
# STATE_FILE=/data/state.json

# Rate limiting (public bot protection)
# Max tracking codes per user (prevent spam)
MAX_CODES_PER_USER=10
# Minimum seconds between checks of the same code (protect CE Express API)
MIN_CHECK_INTERVAL=300

# In-memory cache for CE Express responses (seconds)
# When multiple users track the same code within this window, only 1 API call is made
CACHE_TTL=60

# Telegram bot credentials — see README for how to get these
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Comma-separated list of CE Express tracking codes to watch
TRACKING_CODES=TBKH000649682

# How often to poll (seconds). 3600 = every hour, 7200 = every 2 hours
POLL_INTERVAL=3600

# Where to persist state between runs (default: state.json in current dir)
# STATE_FILE=state.json
